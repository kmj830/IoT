# ==========================================
# 멍메이트(DogMate) IoT 환경 변수 설정 템플릿 (.env.example)
# 실제 값은 .env 파일에 작성해 주세요. (.env는 gitignore로 보호됨)
# ==========================================

# 1. Supabase PostgreSQL 데이터베이스 접속 URI
# 형식: postgresql://postgres:[비밀번호]@db.[프로젝트ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# 2. Google Cloud Platform (GCP) 설정
GCP_PROJECT_ID=dogmate-iot
GCS_BUCKET_NAME=your-bucket-name

# 3. GCP 서비스 계정 키 JSON 파일 상대/절대 경로
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-key.json

# 4. 서버 설정 (macOS AirPlay 수신기와 충돌 방지를 위해 기본 5001 포트 사용)
PORT=5001
FLASK_ENV=development

